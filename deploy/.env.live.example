# Exemplo sem segredos. Copie para /opt/jbfd/live/.env na VPS.
APP_ENV=live
APP_ORIGIN=jobforged.com
APP_HOST_RULE=Host(`jobforged.com`) || Host(`www.jobforged.com`)
APP_PUBLIC_URL=https://jobforged.com
JBFD_IMAGE=jbfd:SUBSTITUA_PELO_COMMIT
JBFD_HOST_PORT=3100
JBFD_DOCKER_NETWORK=jobforged_jobforged_network
# Supabase self-hosted Live, acessível apenas pela rede Docker privada do Live.
SUPABASE_INTERNAL_URL=http://supabase-live-envoy:8000
SUPABASE_ANON_KEY=
# Preencher somente no ambiente Live após aprovação e criação do secret jbfd-live.
BREVO_API_KEY=
