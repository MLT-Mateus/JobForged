# Exemplo sem segredos. Copie para /opt/jbfd/live/.env na VPS.
APP_ENV=live
APP_ORIGIN=jobforged.com
JBFD_IMAGE=jbfd:SUBSTITUA_PELO_COMMIT
JBFD_HOST_PORT=3100
JBFD_DOCKER_NETWORK=jobforged_jobforged_network
# Supabase Cloud Live. A anon key é pública por desenho do Supabase; nunca use service_role no app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
