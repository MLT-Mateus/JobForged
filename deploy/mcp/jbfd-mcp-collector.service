[Unit]
Description=JBFD operational snapshot collector
After=docker.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/jbfd/mcp/bin/collect.py
User=root
Group=root
UMask=0022
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/jbfd/mcp/snapshots
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryMax=128M
TimeoutStartSec=60
