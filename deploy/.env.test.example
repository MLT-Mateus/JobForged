# Exemplo sem segredos. Copie para /opt/jbfd/test/.env na VPS.
APP_ENV=test
APP_ORIGIN=test.jobforged.com
APP_PUBLIC_URL=https://test.jobforged.com
JBFD_IMAGE=jbfd:SUBSTITUA_PELO_COMMIT
JBFD_HOST_PORT=3101
JBFD_DOCKER_NETWORK=jobforged_jobforged_network
# Supabase self-hosted do ambiente Test. O serviço só é acessado pela rede Docker privada.
# A chave anônima nunca deve ser substituída por service_role ou SUPABASE_SECRET_KEY.
SUPABASE_INTERNAL_URL=http://supabase-envoy:8000
SUPABASE_ANON_KEY=
# Configure apenas no ambiente real da VPS ou via deploy protegido; nunca versione o valor.
BREVO_API_KEY=
