# Exemplo sem segredos. Copie para /opt/jbfd/test/.env na VPS.
APP_ENV=test
APP_ORIGIN=test.jobforged.com
JBFD_IMAGE=jbfd:SUBSTITUA_PELO_COMMIT
JBFD_HOST_PORT=3101
JBFD_DOCKER_NETWORK=jobforged_jobforged_network
# Supabase Cloud Test. A anon key é pública por desenho do Supabase; nunca use service_role no app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
